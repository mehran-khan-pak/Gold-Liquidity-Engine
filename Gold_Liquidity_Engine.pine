//@version=6
indicator("Gold Liquidity Engine V0.3", overlay=true, max_lines_count=300, max_labels_count=100)

// ───── Inputs ─────
swingLen = input.int(5, "Swing Strength", minval=3)
minTouches = input.int(2, "Minimum Liquidity Touches", minval=2)
showLiquidity = input.bool(true, "Show Major Liquidity")

// ───── Colors ─────
bslColor = color.red
sslColor = color.blue
sweepColor = color.lime

// ───── Arrays ─────
var line[] liqLines = array.new_line()
var float[] liqPrice = array.new_float()
var int[] liqSide = array.new_int()
var int[] liqTouch = array.new_int()


// ───── Pivot Detection ─────
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)


// ───── Liquidity Tolerance ─────
tolerance = syminfo.mintick * 50


// ───── Function: Check Existing Level ─────
findLevel(price)=>
    int index = -1
    if array.size(liqPrice) > 0
        for i = 0 to array.size(liqPrice)-1
            old = array.get(liqPrice,i)
            if math.abs(old-price) <= tolerance
                index := i
    index


// ───── Create BSL Candidate ─────
if showLiquidity and not na(ph)

    idx = findLevel(ph)

    if idx >= 0
        array.set(liqTouch, idx, array.get(liqTouch,idx)+1)

    else
        l = line.new(
             bar_index-swingLen,
             ph,
             bar_index+100,
             ph,
             extend=extend.right,
             color=bslColor)

        array.push(liqLines,l)
        array.push(liqPrice,ph)
        array.push(liqSide,1)
        array.push(liqTouch,1)


// ───── Create SSL Candidate ─────
if showLiquidity and not na(pl)

    idx = findLevel(pl)

    if idx >= 0
        array.set(liqTouch, idx, array.get(liqTouch,idx)+1)

    else
        l = line.new(
             bar_index-swingLen,
             pl,
             bar_index+100,
             pl,
             extend=extend.right,
             color=sslColor)

        array.push(liqLines,l)
        array.push(liqPrice,pl)
        array.push(liqSide,-1)
        array.push(liqTouch,1)// ───── Major Liquidity Filter ─────

// Remove weak liquidity (single touch levels)
if array.size(liqLines) > 0
    for i = array.size(liqLines) - 1 to 0

        touches = array.get(liqTouch,i)

        if touches < minTouches
            line.delete(array.get(liqLines,i))

            array.remove(liqLines,i)
            array.remove(liqPrice,i)
            array.remove(liqSide,i)
            array.remove(liqTouch,i)


// ───── Sweep Detection & Removal ─────

if array.size(liqLines) > 0

    for i = array.size(liqLines) - 1 to 0

        price = array.get(liqPrice,i)
        side  = array.get(liqSide,i)

        swept = false

        // Buy Side Liquidity sweep
        if side == 1 and high >= price
            swept := true

        // Sell Side Liquidity sweep
        if side == -1 and low <= price
            swept := true


        if swept

            line.delete(array.get(liqLines,i))

            array.remove(liqLines,i)
            array.remove(liqPrice,i)
            array.remove(liqSide,i)
            array.remove(liqTouch,i)


// ───── Highlight Strong Liquidity ─────

if array.size(liqLines) > 0

    for i = 0 to array.size(liqLines)-1

        touches = array.get(liqTouch,i)
        ln = array.get(liqLines,i)

        if touches >= minTouches
            line.set_width(ln,2)
