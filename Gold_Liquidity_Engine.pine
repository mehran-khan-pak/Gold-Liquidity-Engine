//@version=6
indicator("Gold Liquidity Engine V0.4", overlay=true, max_lines_count=300, max_labels_count=100)

// ───── Inputs ─────
swingLen = input.int(8, "Major Swing Strength", minval=3)
atrFilter = input.float(1.5, "Major Move Filter")
showLiquidity = input.bool(true, "Show Liquidity")

// ───── Colors ─────
bslColor = color.red
sslColor = color.blue

// ───── Storage ─────
var line[] levels = array.new_line()
var float[] prices = array.new_float()
var int[] sides = array.new_int()

// ───── ATR ─────
atr = ta.atr(14)


// ───── Major Swing Detection ─────
highPoint = ta.pivothigh(high, swingLen, swingLen)
lowPoint  = ta.pivotlow(low, swingLen, swingLen)


// ───── Create BSL ─────
if showLiquidity and not na(highPoint)

    move = math.abs(highPoint - close[swingLen])

    if move > atr * atrFilter

        ln = line.new(
             bar_index - swingLen,
             highPoint,
             bar_index + 100,
             highPoint,
             extend=extend.right,
             color=bslColor,
             width=2)

        array.push(levels, ln)
        array.push(prices, highPoint)
        array.push(sides, 1)


// ───── Create SSL ─────
if showLiquidity and not na(lowPoint)

    move = math.abs(lowPoint - close[swingLen])

    if move > atr * atrFilter

        ln = line.new(
             bar_index - swingLen,
             lowPoint,
             bar_index + 100,
             lowPoint,
             extend=extend.right,
             color=sslColor,
             width=2)

        array.push(levels, ln)
        array.push(prices, lowPoint)
        array.push(sides, -1)
// ───── Sweep Removal ─────

if array.size(levels) > 0

    for i = array.size(levels) - 1 to 0

        price = array.get(prices, i)
        side  = array.get(sides, i)

        swept = false

        // Buy side liquidity sweep
        if side == 1 and high >= price
            swept := true

        // Sell side liquidity sweep
        if side == -1 and low <= price
            swept := true


        if swept

            line.delete(array.get(levels, i))

            array.remove(levels, i)
            array.remove(prices, i)
            array.remove(sides, i)


// ───── Keep Chart Clean ─────

maxLevels = 20

if array.size(levels) > maxLevels

    removeCount = array.size(levels) - maxLevels

    for i = 0 to removeCount - 1

        line.delete(array.shift(levels))
        array.shift(prices)
        array.shift(sides)


// ───── Equal High / Equal Low Base Detection ─────

eqTolerance = atr * 0.15

if not na(highPoint[1]) and not na(highPoint)

    if math.abs(highPoint - highPoint[1]) <= eqTolerance

        label.new(
             bar_index - swingLen,
             highPoint,
             "EQH",
             style=label.style_label_down,
             color=color.red,
             textcolor=color.white)


if not na(lowPoint[1]) and not na(lowPoint)

    if math.abs(lowPoint - lowPoint[1]) <= eqTolerance

        label.new(
             bar_index - swingLen,
             lowPoint,
             "EQL",
             style=label.style_label_up,
             color=color.blue,
             textcolor=color.white)
