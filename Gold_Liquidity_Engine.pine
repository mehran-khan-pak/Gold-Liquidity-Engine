//@version=6
indicator("Gold Liquidity Engine V0.2", overlay=true, max_lines_count=300, max_labels_count=300)

// ───── Settings ─────
swingLength = input.int(5, "Liquidity Swing Length", minval=2)
showLabels = input.bool(true, "Show Liquidity Labels")
extendBars = input.int(100, "Line Extension")

// ───── Colors ─────
buyLiquidityColor = color.red
sellLiquidityColor = color.blue

// ───── Arrays ─────
var line[] liqLines = array.new_line()
var label[] liqLabels = array.new_label()
var float[] liqPrices = array.new_float()
var int[] liqTypes = array.new_int()

// ───── Swing Points ─────
sHigh = ta.pivothigh(high, swingLength, swingLength)
sLow  = ta.pivotlow(low, swingLength, swingLength)


// ───── Create Buy Side Liquidity ─────
if not na(sHigh)
    ln = line.new(
         bar_index - swingLength,
         sHigh,
         bar_index + extendBars,
         sHigh,
         extend=extend.right,
         color=buyLiquidityColor,
         width=1)

    array.push(liqLines, ln)
    array.push(liqPrices, sHigh)
    array.push(liqTypes, 1)

    if showLabels
        lb = label.new(
             bar_index - swingLength,
             sHigh,
             "BSL",
             style=label.style_label_down,
             color=buyLiquidityColor,
             textcolor=color.white)

        array.push(liqLabels, lb)


// ───── Create Sell Side Liquidity ─────
if not na(sLow)
    ln = line.new(
         bar_index - swingLength,
         sLow,
         bar_index + extendBars,
         sLow,
         extend=extend.right,
         color=sellLiquidityColor,
         width=1)

    array.push(liqLines, ln)
    array.push(liqPrices, sLow)
    array.push(liqTypes, -1)

    if showLabels
        lb = label.new(
             bar_index - swingLength,
             sLow,
             "SSL",
             style=label.style_label_up,
             color=sellLiquidityColor,
             textcolor=color.white)

        array.push(liqLabels, lb)


// ───── Sweep Removal ─────
if array.size(liqLines) > 0
    for i = array.size(liqLines) - 1 to 0

        price = array.get(liqPrices, i)
        typ = array.get(liqTypes, i)

        swept = false

        if typ == 1 and high >= price
            swept := true

        if typ == -1 and low <= price
            swept := true


        if swept
            line.delete(array.get(liqLines, i))

            if array.size(liqLabels) > i
                label.delete(array.get(liqLabels, i))

            array.remove(liqLines, i)
            array.remove(liqPrices, i)
            array.remove(liqTypes, i)

            if array.size(liqLabels) > i
                array.remove(liqLabels, i)
