//@version=6
indicator("Gold Liquidity Engine V0.6", overlay=true, max_lines_count=300, max_labels_count=200)

// ───── Settings ─────
swingLen = input.int(10, "Major Swing Length", minval=3)
touchNeeded = input.int(2, "Liquidity Touches", minval=1)
maxLevels = input.int(30, "Maximum Levels")

// ───── Colors ─────
buyColor = color.red
sellColor = color.blue
sweepColor = color.lime

// ───── Storage ─────
var line[] levels = array.new_line()
var float[] prices = array.new_float()
var int[] sides = array.new_int()
var int[] touches = array.new_int()
var bool[] swept = array.new_bool()

// ───── Swing Detection ─────
highSwing = ta.pivothigh(high, swingLen, swingLen)
lowSwing  = ta.pivotlow(low, swingLen, swingLen)


// ───── ATR Based Distance ─────
atr = ta.atr(14)
rangeLimit = atr * 0.15


// ───── Find Existing Liquidity ─────
findLiquidity(price)=>

    result = -1

    if array.size(prices) > 0
        for i = 0 to array.size(prices)-1

            oldPrice = array.get(prices,i)

            if math.abs(price-oldPrice) <= rangeLimit
                result := i

    result


// ───── Create Buy Side Liquidity ─────
if not na(highSwing)

    idx = findLiquidity(highSwing)

    if idx >= 0

        array.set(touches, idx, array.get(touches,idx)+1)

    else

        ln = line.new(
             bar_index-swingLen,
             highSwing,
             bar_index+150,
             highSwing,
             extend=extend.right,
             color=buyColor,
             width=2)

        array.push(levels,ln)
        array.push(prices,highSwing)
        array.push(sides,1)
        array.push(touches,1)
        array.push(swept,false)


// ───── Create Sell Side Liquidity ─────
if not na(lowSwing)

    idx = findLiquidity(lowSwing)

    if idx >= 0

        array.set(touches, idx, array.get(touches,idx)+1)

    else

        ln = line.new(
             bar_index-swingLen,
             lowSwing,
             bar_index+150,
             lowSwing,
             extend=extend.right,
             color=sellColor,
             width=2)

        array.push(levels,ln)
        array.push(prices,lowSwing)
        array.push(sides,-1)
        array.push(touches,1)
        array.push(swept,false)// ───── Sweep Detection + Neon Green Mark ─────

if array.size(levels) > 0

    for i = 0 to array.size(levels)-1

        price = array.get(prices,i)
        side  = array.get(sides,i)
        isSwept = array.get(swept,i)

        if not isSwept

            hit = false

            // Buy Side Liquidity sweep
            if side == 1 and high >= price
                hit := true

            // Sell Side Liquidity sweep
            if side == -1 and low <= price
                hit := true


            if hit

                line.set_color(array.get(levels,i), sweepColor)
                line.set_width(array.get(levels,i), 3)

                array.set(swept,i,true)


// ───── Remove Weak Liquidity ─────

if array.size(levels) > 0

    for i = array.size(levels)-1 to 0

        touchCount = array.get(touches,i)
        isSwept = array.get(swept,i)

        // Sirf weak unswept levels remove
        if touchCount < touchNeeded and not isSwept

            line.delete(array.get(levels,i))

            array.remove(levels,i)
            array.remove(prices,i)
            array.remove(sides,i)
            array.remove(touches,i)
            array.remove(swept,i)


// ───── Limit Visible Levels ─────

if array.size(levels) > maxLevels

    extra = array.size(levels) - maxLevels

    for i = 0 to extra - 1

        line.delete(array.shift(levels))
        array.shift(prices)
        array.shift(sides)
        array.shift(touches)
        array.shift(swept)
