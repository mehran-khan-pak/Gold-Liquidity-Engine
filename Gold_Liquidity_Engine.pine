//@version=6
indicator("Gold Liquidity Engine V0.5", overlay=true, max_lines_count=300, max_labels_count=200)

// ───── Inputs ─────
swingLen = input.int(10, "Major Liquidity Swing", minval=3)
atrMult = input.float(1.8, "Liquidity Strength")
maxKeep = input.int(25, "Max Active Liquidity")

// ───── Colors ─────
buyColor = color.red
sellColor = color.blue
eqColor = color.orange

// ───── Arrays ─────
var line[] liqLines = array.new_line()
var float[] liqPrices = array.new_float()
var int[] liqSide = array.new_int()


// ───── ATR ─────
atr = ta.atr(14)


// ───── Swings ─────
sHigh = ta.pivothigh(high, swingLen, swingLen)
sLow  = ta.pivotlow(low, swingLen, swingLen)


// ───── Liquidity Strength Check ─────
strongMove(level)=>

    math.abs(level - close[swingLen]) > atr * atrMult



// ───── Buy Side Liquidity ─────
if not na(sHigh)

    if strongMove(sHigh)

        ln = line.new(
             bar_index - swingLen,
             sHigh,
             bar_index + 150,
             sHigh,
             extend=extend.right,
             color=buyColor,
             width=2)

        array.push(liqLines, ln)
        array.push(liqPrices, sHigh)
        array.push(liqSide, 1)


// ───── Sell Side Liquidity ─────
if not na(sLow)

    if strongMove(sLow)

        ln = line.new(
             bar_index - swingLen,
             sLow,
             bar_index + 150,
             sLow,
             extend=extend.right,
             color=sellColor,
             width=2)

        array.push(liqLines, ln)
        array.push(liqPrices, sLow)
        array.push(liqSide, -1)// ───── Sweep Detection & Remove ─────

if array.size(liqLines) > 0

    for i = array.size(liqLines) - 1 to 0

        price = array.get(liqPrices, i)
        side  = array.get(liqSide, i)

        sweep = false

        if side == 1 and high >= price
            sweep := true

        if side == -1 and low <= price
            sweep := true


        if sweep

            line.delete(array.get(liqLines, i))

            array.remove(liqLines, i)
            array.remove(liqPrices, i)
            array.remove(liqSide, i)


// ───── Keep Only Recent Major Liquidity ─────

if array.size(liqLines) > maxKeep

    extra = array.size(liqLines) - maxKeep

    for i = 0 to extra - 1

        line.delete(array.shift(liqLines))
        array.shift(liqPrices)
        array.shift(liqSide)


// ───── EQH / EQL Liquidity Pool ─────

eqRange = atr * 0.12

prevHigh = ta.valuewhen(not na(sHigh), sHigh, 1)
prevLow  = ta.valuewhen(not na(sLow), sLow, 1)


if not na(sHigh) and not na(prevHigh)

    if math.abs(sHigh - prevHigh) <= eqRange

        label.new(
             bar_index - swingLen,
             sHigh,
             "EQH Liquidity",
             style=label.style_label_down,
             color=eqColor,
             textcolor=color.white)



if not na(sLow) and not na(prevLow)

    if math.abs(sLow - prevLow) <= eqRange

        label.new(
             bar_index - swingLen,
             sLow,
             "EQL Liquidity",
             style=label.style_label_up,
             color=eqColor,
             textcolor=color.white)
